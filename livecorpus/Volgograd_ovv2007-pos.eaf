    <TIER LINGUISTIC_TYPE_REF="phonetic_transcription"
        PARENT_REF="words@ovv2007f" PARTICIPANT="vanessa" TIER_ID="comment@lpp2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>тут отвечает на вопрос "где?" - наречие, но здесь скорее как частица</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>сомневаюсь, что в данном контексте "это" местоимение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>то же самое, что и с "это", думаю "то" здесь скорее как частица</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>"в целом" вметсе выступает как наречие</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
